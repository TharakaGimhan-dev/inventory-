# The API service. Server-side only - the browser never calls it directly, it
# calls /api/v1/... on this app's own origin and Next proxies it (next.config.mjs).
#
# Because of that, this does NOT need a NEXT_PUBLIC_ prefix, and should not have
# one: the API's internal URL is not something to ship to the browser.
API_URL=http://localhost:3001
