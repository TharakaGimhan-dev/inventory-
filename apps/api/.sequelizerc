// .sequelizerc tells sequelize-cli where things live, because the CLI's defaults
// assume a plain JS project and this one is TypeScript with a dist/ build.
const path = require('path');

module.exports = {
  config: path.resolve('config', 'sequelize.config.js'),
  'migrations-path': path.resolve('migrations'),
  'seeders-path': path.resolve('seeders'),
};
