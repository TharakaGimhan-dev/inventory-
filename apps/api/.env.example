# Copy to .env for local development. Never commit .env itself.

NODE_ENV=development
PORT=3001

# Local: docker run -p 5432:5432 -e POSTGRES_PASSWORD=inventory -d postgres:16
# Railway: set this to ${{Postgres.DATABASE_URL}} - reference the service, do not
# paste the value, so a rotated password does not break the deploy.
DATABASE_URL=postgres://postgres:inventory@localhost:5432/inventory

# Local: docker run -p 6379:6379 -d redis:7
# Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

# Generate each with: openssl rand -base64 48
# These two must be different values.
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48-output-value
JWT_REFRESH_SECRET=replace-me-with-a-different-openssl-rand-base64-48-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated. Must include the deployed web URL in production.
CORS_ORIGINS=http://localhost:3000

# Used to build the return, cancel and notify URLs a payment provider needs.
# In production these are the real public URLs of the two services.
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# Not used until later phases. Server-side only: never add a NEXT_PUBLIC_ prefix
# to IMAGEKIT_PRIVATE_KEY or PAYHERE_SECRET - that would ship them to the browser.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# PayHere. Leave empty and the app runs with online payment switched off -
# /billing/subscribe answers "not configured yet" rather than half-working.
# PAYHERE_SANDBOX=true points checkout at the sandbox; anything else is live.
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
PAYHERE_SANDBOX=true
